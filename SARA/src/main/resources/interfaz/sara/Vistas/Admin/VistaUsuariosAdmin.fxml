<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="interfaz.sara.Controladores.Admin.ControladorUsuariosAdmin"
      styleClass="root-container-admin" 
      spacing="0"
      VBox.vgrow="ALWAYS"
      HBox.hgrow="ALWAYS">

    <!-- Componente Sidebar Compartido -->
    <fx:include fx:id="sidebarInclude" 
                source="ComponenteSidebarAdmin.fxml" 
                HBox.hgrow="NEVER"/>

    <!-- Contenido principal -->
    <ScrollPane fitToWidth="true" 
               styleClass="scroll-pane-custom-admin" 
               HBox.hgrow="ALWAYS" 
               VBox.vgrow="ALWAYS">
        
        <VBox styleClass="contenido-principal-admin" 
              alignment="TOP_CENTER" 
              spacing="0"
              VBox.vgrow="ALWAYS"
              HBox.hgrow="ALWAYS">
            
            <padding>
                <Insets left="24.0"/>
            </padding>
            
            <VBox styleClass="contenido-ancho-maximo-admin" 
                  spacing="20.0" 
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS">
                
                <padding>
                    <Insets top="20.0" right="40.0" bottom="20.0" left="40.0"/>
                </padding>
                
                <!-- Encabezado con título -->
                <HBox alignment="CENTER_LEFT" 
                     spacing="20.0"
                     HBox.hgrow="ALWAYS">
                    
                    <Label text="Usuarios" 
                          styleClass="titulo-pagina-admin" 
                          maxWidth="Infinity" 
                          HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Barra de búsqueda y filtros -->
                <HBox styleClass="barra-busqueda-admin" 
                     alignment="CENTER_LEFT" 
                     spacing="12.0"
                     HBox.hgrow="ALWAYS">
                    
                    <TextField fx:id="campoBusqueda" 
                              promptText="Buscar por nombre, correo o matrícula..." 
                              styleClass="input-busqueda-admin" 
                              HBox.hgrow="ALWAYS" 
                              onKeyReleased="#filtrarUsuarios"/>
                    
                    <ComboBox fx:id="filtroRol" 
                             promptText="Todos los roles" 
                             styleClass="combo-filtro-rol-admin" 
                             onAction="#filtrarUsuarios" 
                             minWidth="120.0"
                             prefWidth="150.0"
                             maxWidth="200.0"/>
                </HBox>

                <!-- Contenedor de tarjetas de usuarios -->
                <FlowPane fx:id="contenedorUsuarios" 
                         hgap="16.0" 
                         vgap="16.0" 
                         VBox.vgrow="ALWAYS"
                         HBox.hgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>

