<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="interfaz.sara.Controladores.Admin.ControladorEditarUsuarioAdmin"
      styleClass="root-container-admin" 
      spacing="0"
      VBox.vgrow="ALWAYS"
      HBox.hgrow="ALWAYS">

    <!-- Componente Sidebar Compartido -->
    <fx:include fx:id="sidebarInclude" 
                source="ComponenteSidebarAdmin.fxml" 
                HBox.hgrow="NEVER"/>

    <!-- Contenido principal -->
    <ScrollPane fitToWidth="true" 
               styleClass="scroll-pane-custom-admin" 
               HBox.hgrow="ALWAYS" 
               VBox.vgrow="ALWAYS">
        
        <VBox styleClass="contenido-principal-admin" 
              alignment="TOP_CENTER"
              VBox.vgrow="ALWAYS"
              HBox.hgrow="ALWAYS">
            
            <VBox styleClass="contenido-ancho-maximo-admin" 
                  spacing="0"
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS">
                
                <padding>
                    <Insets top="20.0" right="40.0" bottom="20.0" left="40.0"/>
                </padding>
                
                <!-- Encabezado con botón volver y título -->
                <HBox alignment="CENTER_LEFT" 
                     spacing="20.0"
                     HBox.hgrow="ALWAYS">
                    
                    <Button text="← Volver" 
                           styleClass="boton-volver-admin" 
                           onAction="#manejarVolver"/>
                    
                    <Label text="Editar Usuario" 
                          styleClass="titulo-pagina-admin" 
                          maxWidth="Infinity" 
                          HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Espaciador -->
                <Region minHeight="32.0"/>

                <!-- Tarjeta de perfil con imagen -->
                <HBox styleClass="tarjeta-perfil-admin" 
                     spacing="24.0" 
                     alignment="CENTER_LEFT">
                    
                    <!-- Imagen de perfil circular -->
                    <ImageView fx:id="profileImageView" 
                              fitHeight="120.0" 
                              fitWidth="120.0" 
                              pickOnBounds="true" 
                              preserveRatio="true" 
                              styleClass="imagen-perfil-grande-admin">
                        <clip>
                            <Circle centerX="60.0" 
                                   centerY="60.0" 
                                   radius="60.0" />
                        </clip>
                    </ImageView>
                    
                    <!-- Información básica -->
                    <VBox alignment="CENTER_LEFT" 
                         spacing="8.0">
                        
                        <Label fx:id="labelNombreUsuario" 
                              text="Cargando..." 
                              styleClass="texto-nombre-grande-admin"/>
                        
                        <Label fx:id="labelEmailUsuario" 
                              text="Cargando..." 
                              styleClass="texto-email-grande-admin"/>
                    </VBox>
                </HBox>

                <!-- Espaciador -->
                <Region minHeight="24.0"/>

                <!-- Formulario de edición -->
                <VBox styleClass="grid-detalles-admin" 
                     spacing="24.0">
                    
                    <!-- Sección: Datos Personales -->
                    <Label text="Datos Personales" 
                          styleClass="texto-seccion-admin"/>
                    
                    <GridPane hgap="20.0" 
                             vgap="20.0">
                        
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="150.0"/> 
                            <ColumnConstraints hgrow="ALWAYS" minWidth="300.0"/> 
                        </columnConstraints>
                        
                        <!-- Campo: Nombre -->
                        <Label text="Nombre" 
                              styleClass="texto-etiqueta-admin" 
                              GridPane.columnIndex="0" 
                              GridPane.rowIndex="0"/>
                        <TextField fx:id="campoNombre" 
                                  promptText="Nombre completo" 
                                  styleClass="input-field-admin" 
                                  GridPane.columnIndex="1" 
                                  GridPane.rowIndex="0"/>
                        
                        <!-- Campo: Correo Electrónico -->
                        <Label text="Correo Electrónico" 
                              styleClass="texto-etiqueta-admin" 
                              GridPane.columnIndex="0" 
                              GridPane.rowIndex="1"/>
                        <TextField fx:id="campoEmail" 
                                  promptText="correo@ejemplo.com" 
                                  styleClass="input-field-admin" 
                                  GridPane.columnIndex="1" 
                                  GridPane.rowIndex="1"/>
                        
                        <!-- Campo: Matrícula -->
                        <Label text="Matrícula" 
                              styleClass="texto-etiqueta-admin" 
                              GridPane.columnIndex="0" 
                              GridPane.rowIndex="2"/>
                        <TextField fx:id="campoMatricula" 
                                  promptText="Matrícula o ID" 
                                  styleClass="input-field-admin" 
                                  GridPane.columnIndex="1" 
                                  GridPane.rowIndex="2"/>
                        
                        <!-- Campo: Contraseña -->
                        <Label text="Nueva Contraseña" 
                              styleClass="texto-etiqueta-admin" 
                              GridPane.columnIndex="0" 
                              GridPane.rowIndex="3"/>
                        <PasswordField fx:id="campoContrasena" 
                                      promptText="Dejar vacío para no cambiar" 
                                      styleClass="input-field-admin" 
                                      GridPane.columnIndex="1" 
                                      GridPane.rowIndex="3"/>
                    </GridPane>
                    
                    <!-- Separador -->
                    <Region minHeight="8.0"/>
                    
                    <!-- Sección: Roles -->
                    <Label text="Roles y Permisos" 
                          styleClass="texto-seccion-admin"/>
                    
                    <VBox spacing="12.0">
                        <Label text="Rol del Usuario" 
                              styleClass="texto-etiqueta-admin"/>
                        <ComboBox fx:id="comboRoles" 
                                 promptText="Seleccionar rol" 
                                 styleClass="combo-roles-admin" 
                                 prefWidth="300.0"/>
                    </VBox>
                    
                    <!-- Separador -->
                    <Region minHeight="8.0"/>
                    
                    <!-- Sección: Estado de la Cuenta -->
                    <Label text="Estado de la Cuenta" 
                          styleClass="texto-seccion-admin"/>
                    
                    <VBox spacing="12.0">
                        <CheckBox fx:id="checkCuentaActiva" 
                                 text="Cuenta activa" 
                                 styleClass="checkbox-admin"/>
                        <Label text="Cuando la cuenta está desactivada, el usuario no podrá iniciar sesión." 
                              styleClass="texto-ayuda-admin"/>
                    </VBox>
                </VBox>

                <!-- Espaciador -->
                <Region minHeight="24.0"/>

                <!-- Contenedor de botones de acción -->
                <HBox spacing="16.0" 
                     alignment="CENTER_LEFT" 
                     styleClass="contenedor-botones-admin">
                    
                    <Button text="Guardar Cambios" 
                           styleClass="boton-accion-primario-admin" 
                           onAction="#manejarGuardarCambios"/>
                    
                    <Button text="Deshabilitar Cuenta" 
                           styleClass="boton-accion-warning-admin" 
                           onAction="#manejarDeshabilitarCuenta"/>
                    
                    <Button text="Eliminar Usuario" 
                           styleClass="boton-accion-secundario-admin" 
                           onAction="#manejarEliminarUsuario"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>

