<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="interfaz.sara.Controladores.Admin.ControladorSalasAdmin"
      styleClass="root-container-admin" 
      spacing="0"
      VBox.vgrow="ALWAYS"
      HBox.hgrow="ALWAYS">

    <!-- Componente Sidebar Compartido -->
    <fx:include fx:id="sidebarInclude" 
                source="ComponenteSidebarAdmin.fxml" 
                HBox.hgrow="NEVER"/>

    <!-- Contenido principal -->
    <ScrollPane fitToWidth="true" 
               styleClass="scroll-pane-custom-admin" 
               HBox.hgrow="ALWAYS" 
               VBox.vgrow="ALWAYS">
        
        <VBox styleClass="contenido-principal-admin" 
              spacing="24.0" 
              VBox.vgrow="ALWAYS"
              HBox.hgrow="ALWAYS">
            
            <padding>
                <Insets top="20.0" right="40.0" bottom="20.0" left="64.0"/>
            </padding>
            
            <!-- Encabezado con título y botón -->
            <HBox alignment="CENTER_LEFT" 
                 spacing="20.0"
                 HBox.hgrow="ALWAYS">
                
                <Label text="Gestión de Salas" 
                      styleClass="titulo-pagina-admin" 
                      maxWidth="Infinity" 
                      HBox.hgrow="ALWAYS"/>
                
                <Button text="Registrar Nueva Sala" 
                       styleClass="boton-secundario-admin" 
                       onAction="#manejarRegistrarSala"/>
            </HBox>

            <!-- Contenedor de tarjetas de salas -->
            <FlowPane fx:id="contenedorSalas" 
                     hgap="16.0" 
                     vgap="24.0" 
                     VBox.vgrow="ALWAYS"
                     HBox.hgrow="ALWAYS"/>
        </VBox>
    </ScrollPane>
</HBox>

