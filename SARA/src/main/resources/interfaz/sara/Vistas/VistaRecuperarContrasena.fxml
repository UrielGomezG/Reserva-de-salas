<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>

<StackPane xmlns="http://javafx.com/javafx/21" 
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="interfaz.sara.Controladores.ControladorRecuperarContrasena"
           styleClass="login-container"
           VBox.vgrow="ALWAYS" 
           HBox.hgrow="ALWAYS">

    <!-- Nombre de la aplicación en la esquina superior izquierda -->
    <BorderPane styleClass="login-root">
        <top>
            <HBox styleClass="login-header">
                <Label text="Sara" styleClass="app-name"/>
            </HBox>
        </top>
        <center>
            <!-- Contenedor principal del formulario -->
            <VBox alignment="CENTER" spacing="30.0" styleClass="login-form-container">
                <padding>
                    <Insets top="50.0" right="50.0" bottom="50.0" left="50.0"/>
                </padding>

                <!-- Título -->
                <Label text="Recuperar Contraseña" styleClass="login-title"/>

                <!-- Contenedor de campos del formulario -->
                <VBox spacing="25.0" alignment="CENTER">
                    
                    <!-- Descripción -->
                    <Label text="Ingresa tu correo electrónico para recibir un código de recuperación" 
                           styleClass="register-label"
                           wrapText="true"
                           maxWidth="350.0"
                           alignment="CENTER"/>

                    <!-- Campo de correo electrónico -->
                    <VBox spacing="8.0" alignment="CENTER_LEFT">
                        <Label text="Correo electrónico" styleClass="login-label"/>
                        <TextField fx:id="campoCorreo" 
                                  promptText="TuCorreo@utez.edu.mx"
                                  prefWidth="350.0"
                                  styleClass="login-text-field"/>
                    </VBox>

                    <!-- Mensaje de error/éxito (inicialmente oculto) -->
                    <Label fx:id="mensajeEstado" 
                           styleClass="login-error-message"
                           visible="false"
                           wrapText="true"
                           maxWidth="350.0"/>

                    <!-- Botón de enviar código -->
                    <Button fx:id="botonEnviarCodigo" 
                           text="Enviar Código"
                           onAction="#manejarEnviarCodigo"
                           prefWidth="350.0"
                           prefHeight="45.0"
                           styleClass="login-button"/>

                    <!-- Enlace para volver al login -->
                    <HBox alignment="CENTER" spacing="5.0">
                        <Label text="¿Recordaste tu contraseña?" styleClass="register-label"/>
                        <Hyperlink text="Iniciar sesión" styleClass="register-link" onAction="#manejarVolverALogin"/>
                    </HBox>

                </VBox>

            </VBox>
        </center>
    </BorderPane>

</StackPane>

